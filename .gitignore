# ---- 运行时与工具链（体积大，安装脚本负责获取）----
runtime/
offline/

# ---- 平台运行数据（含实验室案例/会话/密钥，绝不入库）----
platform/data/
platform/jwt.key
platform/secret.key
platform/config.json
platform/platform.exe
platform/*.log
*.log

# ---- 前端构建产物与依赖 ----
platform/web/node_modules/
platform/web/out/
platform/web/.next/
platform/web/.turbo/
platform/server/webui/dist/
platform/web/tsconfig.tsbuildinfo

# ---- 实验室抓包样本（含真实设备流量，可能含凭据；需要复现时自行脱敏后添加）----
*.pcap
*.pcapng
*.cap

# ---- Python ----
__pycache__/
*.pyc
.venv/

# ---- 杂项 ----
.DS_Store
Thumbs.db
*.tmp
*.bak
scripts/tmp_*
tools/tests/tmp_*
